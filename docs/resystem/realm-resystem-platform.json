{
  "id": "resystem-platform",
  "realm": "resystem-platform",
  "displayName": "Resystem Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["en"],
  "defaultLocale": "en",
  "rememberMe": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "editUsernameAllowed": false,
  "requiredCredentials": ["password"],
  "defaultRoles": ["resystem-user"],
  "roles": {
    "realm": [
      {
        "name": "resystem-user",
        "description": "Baseline access to Resystem applications"
      },
      {
        "name": "platform-admin",
        "description": "Full administrative access to the Resystem platform"
      },
      {
        "name": "operations",
        "description": "Operational and SRE access for runtime support"
      },
      {
        "name": "auditor",
        "description": "Read-only access for audit and compliance"
      },
      {
        "name": "tenant-admin",
        "description": "Delegated tenant administrator"
      },
      {
        "name": "tenant-user",
        "description": "Standard tenant user"
      },
      {
        "name": "service",
        "description": "Service account role for automation and APIs"
      }
    ],
    "client": {}
  },
  "groups": [
    {
      "name": "platform-admins",
      "path": "/platform-admins",
      "attributes": {
        "description": ["Full platform administration"]
      },
      "realmRoles": ["platform-admin"]
    },
    {
      "name": "operations",
      "path": "/operations",
      "attributes": {
        "description": ["Operational support and SRE"]
      },
      "realmRoles": ["operations"]
    },
    {
      "name": "auditors",
      "path": "/auditors",
      "attributes": {
        "description": ["Read-only visibility"]
      },
      "realmRoles": ["auditor"]
    },
    {
      "name": "tenants",
      "path": "/tenants",
      "attributes": {
        "description": ["Shared container for tenant groups"]
      },
      "subGroups": [
        {
          "name": "tenant-admins",
          "path": "/tenants/tenant-admins",
          "realmRoles": ["tenant-admin"]
        },
        {
          "name": "tenant-users",
          "path": "/tenants/tenant-users",
          "realmRoles": ["tenant-user", "resystem-user"]
        }
      ]
    }
  ],
  "defaultGroups": ["/tenants/tenant-users"],
  "smtpServer": {
    "from": "no-reply@resystem.example",
    "host": "smtp.resystem.example",
    "port": "587"
  },
  "clients": [
    {
      "clientId": "resystem-console",
      "name": "Resystem Administration Console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "CHANGE_ME",
      "redirectUris": [
        "https://console.resystem.example/*"
      ],
      "webOrigins": ["+"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "profile",
        "email",
        "web-origins",
        "role_list"
      ],
      "optionalClientScopes": ["address", "phone", "offline_access"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://console.resystem.example/*"
      },
      "authorizationServicesEnabled": true
    },
    {
      "clientId": "resystem-api",
      "name": "Resystem API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "authorizationServicesEnabled": false
    }
  ],
  "clientScopes": [
    {
      "name": "resystem-groups",
      "description": "Maps group path and realm roles into tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "group-path",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_roles"
          }
        }
      ]
    }
  ],
  "defaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins",
    "resystem-groups"
  ],
  "users": [
    {
      "username": "bootstrap-admin",
      "enabled": true,
      "email": "bootstrap-admin@resystem.example",
      "emailVerified": true,
      "firstName": "Bootstrap",
      "lastName": "Admin",
      "realmRoles": ["platform-admin"],
      "groups": ["/platform-admins"],
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE_ME",
          "temporary": true
        }
      ]
    },
    {
      "username": "tenant-admin",
      "enabled": true,
      "email": "tenant-admin@resystem.example",
      "emailVerified": true,
      "firstName": "Tenant",
      "lastName": "Administrator",
      "realmRoles": ["tenant-admin"],
      "groups": ["/tenants/tenant-admins"],
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE_ME",
          "temporary": true
        }
      ]
    },
    {
      "username": "tenant-user",
      "enabled": true,
      "email": "tenant-user@resystem.example",
      "emailVerified": true,
      "firstName": "Tenant",
      "lastName": "User",
      "realmRoles": ["tenant-user", "resystem-user"],
      "groups": ["/tenants/tenant-users"],
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE_ME",
          "temporary": true
        }
      ]
    }
  ]
}
